{
  "name": "tastybites-pos-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Tasty Bites POS desktop shell — build on your PC only, never deploy to Hostinger",
  "scripts": {
    "start": "electron ..",
    "dev": "concurrently -k \"npm run dev --prefix ..\" \"wait-on http://localhost:3000 && electron ..\"",
    "build:win": "electron-builder --win --projectDir .. --config electron-builder.yml",
    "build:dir": "electron-builder --win --dir --projectDir .. --config electron-builder.yml"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  }
}
